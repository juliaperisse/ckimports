# ---------------------------------------------------------------
# CK Importadora — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA comite o .env.local.
# ---------------------------------------------------------------

# URL pública do site (sem barra no fim)
NEXT_PUBLIC_SITE_URL=https://ckimports.com.br

# --- Mercado Pago -----------------------------------------------
# Painel > Suas integrações > sua aplicação > Credenciais de produção
# Use as credenciais de TESTE enquanto estiver testando.
MERCADO_PAGO_ACCESS_TOKEN=

# Painel > sua aplicação > Webhooks > "Assinatura secreta"
# Sem isso o webhook é recusado em produção.
MERCADO_PAGO_WEBHOOK_SECRET=

# --- Aviso de venda por e-mail (Resend) --------------------------
# https://resend.com > API Keys
RESEND_API_KEY=

# Para onde vão os avisos de venda (separe por vírgula para vários)
EMAIL_VENDAS=

# Remetente verificado no Resend.
# Antes de verificar seu domínio, use: CK Importadora <onboarding@resend.dev>
EMAIL_REMETENTE=CK Importadora <onboarding@resend.dev>
